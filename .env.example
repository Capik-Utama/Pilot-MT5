# PocketBase must be running locally before starting the Pilot server.
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SUPERUSER_EMAIL=admin@example.local
POCKETBASE_SUPERUSER_PASSWORD=

# The first dashboard account created by `pnpm pocketbase:setup`.
POCKETBASE_OWNER_USERNAME=owner
POCKETBASE_OWNER_PASSWORD=

PORT=3000
