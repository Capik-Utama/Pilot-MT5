# Express API + Supabase self-hosted VPS runtime only; never add this file to Vercel.
PORT=3000
NODE_ENV=production
API_ONLY=true
PUBLIC_API_URL=https://api.example.com
FRONTEND_URL=https://pilot.example.com
# Exact frontend origins, comma-separated; no wildcard.
CORS_FRONTEND_ORIGIN=https://pilot.example.com
PILOT_OWNER_EMAIL=owner@example.com

# Server-only Supabase Auth/PostgreSQL settings.
# Use the database connection string for the dedicated least-privilege API login,
# not the postgres/admin account. Keep TLS enabled as required by your VPS setup.
DATABASE_URL=
# Optional: false only if the VPS uses a self-signed DB certificate and the network is private.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
SUPABASE_URL=https://supabase.example.com
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# SUPABASE_SECRET_KEY is server-only and required for Auth user invitations/revocation.
# Browser-safe only; publishable/anon key may be configured in Vercel if browser Auth uses it.
VITE_SUPABASE_URL=https://supabase.example.com
VITE_SUPABASE_ANON_KEY=

# Vercel frontend build/runtime: public API origin only; no DB credentials or service-role key.
# VITE_API_BASE_URL=https://api.example.com
