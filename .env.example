PORT=3000
# API VPS only. Use exact origins without a trailing slash or path.
NODE_ENV=production
API_ONLY=true
PUBLIC_API_URL=https://api.example.com
FRONTEND_URL=https://pilot.example.com
CORS_ORIGINS=https://pilot.example.com

# Manus OAuth and session signing. Keep all values server-side.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
APP_SESSION_SECRET=
PILOT_OWNER_EMAIL=

# Active application code still uses MySQL. Do not put database credentials in Vercel.
# Supabase/PostgreSQL migration is intentionally deferred; do not use a Postgres URL yet.
DATABASE_URL=

# Vercel build environment only; this value is public in the generated frontend.
# VITE_API_BASE_URL=https://api.example.com
